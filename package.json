{
	"name": "Yadd",
	"version": "0.0.1",
	"private": true,
	"prisma": {
		"seed": "bun prisma/seed.ts"
	},
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"test": "bun test:integration && bun test:unit",
		"check": "bunx svelte-kit sync && bunx svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bunx svelte-kit sync && bunx svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "bunx prettier --check . && bunx eslint .",
		"format": "bunx prettier --write .",
		"test:integration": "bunx playwright test",
		"test:unit": "bun test",
		"test:watch": "bun test --watch",
		"test:integration:watch": "bunx playwright test --watch --headed",
		"start:prod": "bunx prisma db push && bun run build/index.js",
		"ci": "bunx prisma db push && bun test && bun run coverage"
	},
	"devDependencies": {
		"@playwright/test": "^1.48.0",
		"@skeletonlabs/skeleton": "^2.10.2",
		"@skeletonlabs/tw-plugin": "^0.4.0",
		"@sveltejs/adapter-auto": "^3.2.5",
		"@sveltejs/adapter-node": "^5.2.6",
		"@sveltejs/kit": "^2.6.4",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/typography": "^0.5.15",
		"@types/eslint": "^9.6.1",
		"@types/node": "^22.8.6",
		"@types/node-cron": "^3.0.11",
		"@typescript-eslint/eslint-plugin": "^8.11.0",
		"@typescript-eslint/parser": "^8.11.0",
		"autoprefixer": "^10.4.20",
		"eslint": "^9.13.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.44.1",
		"postcss": "^8.4.47",
		"prettier": "^3.3.3",
		"prettier-plugin-svelte": "^3.2.7",
		"prisma": "^5.21.1",
		"svelte": "^5.1.9",
		"svelte-check": "^4.0.5",
		"sveltekit-superforms": "^2.19.1",
		"tailwindcss": "^3.4.14",
		"typescript": "^5.6.3",
		"vite": "^5.4.10",
		"zod": "^3.23.8"
	},
	"type": "module",
	"dependencies": {
		"@prisma/client": "^5.21.1",
		"node-cron": "^3.0.3"
	}
}
